# Rendered at container start from PORTAL_HTTP_PATH_PREFIX (no trailing slash; default /hammrly/portal).
# Vite asset URLs use the same prefix via VITE_BASE_PATH at image build time.
# Kubernetes deployments mount a Helm-rendered config over this file.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # TLS terminates at the edge proxy; this pod listens on plain HTTP.
    absolute_redirect off;
    port_in_redirect off;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = ${PORTAL_HTTP_PATH_PREFIX}/config.json {
        add_header Cache-Control "no-cache";
        alias /usr/share/nginx/html/config.json;
    }

    location ${PORTAL_HTTP_PATH_PREFIX}/ {
        alias /usr/share/nginx/html/;
        try_files $$uri $$uri/ ${PORTAL_HTTP_PATH_PREFIX}/index.html;
    }

    location = ${PORTAL_HTTP_PATH_PREFIX} {
        return 301 ${PORTAL_HTTP_PATH_PREFIX}/;
    }

    location = / {
        try_files /index.html =404;
    }
}
